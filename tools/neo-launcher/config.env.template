# NeoB 配置（位于 NeoB.app/Contents/Resources/config.env，可随改随生效）
# 注意：含空格的路径必须加引号，否则 source 时会被当成命令

# 仓库根目录（用于定位 claw-app 构建产物与 claw-server 二进制）
REPO_ROOT=/Users/sam/Documents/projects/personal/app/BrowserOS

# 真实浏览器二进制名（与启动脚本同在 Contents/MacOS/）
NEO_EXECUTABLE="BrowserOS neo"

# 端口：刻意避开官方默认（官方会占 9200 / 9010 / 9210 / 49337）
SERVER_PORT=9310
CDP_PORT=49350

# 数据与状态目录（与官方 profile 隔离）
PROFILE_DIR="$HOME/Library/Application Support/NeoB/profile"
STATE_DIR="$HOME/Library/Application Support/NeoB/state"

# 写入 sidecar 的浏览器版本标识。
# build-app.sh 在打包时从官方 Info.plist 的 CFBundleShortVersionString 生成这一行，
# 不要手工改成本机内核之外的版本。
